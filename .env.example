# Copy to .env.local and fill in. Never commit .env.local.
# Local values are printed by `npx supabase status`.

# Public: safe to expose to the browser. Data access is protected by Row Level Security.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Map tiles. Defaults to OpenStreetMap, which is fine for development but has a strict
# usage policy; use a licensed provider (ideally satellite imagery) in production.
NEXT_PUBLIC_MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
NEXT_PUBLIC_MAP_TILE_ATTRIBUTION=&copy; OpenStreetMap contributors

# Server only (never NEXT_PUBLIC_): enables AI crop-health help on observations with photos.
# Leave empty to switch the feature off. Photos are sent to Anthropic only when a farmer asks.
ANTHROPIC_API_KEY=

# TESTS ONLY: used by integration/e2e tests to clean up test users on the LOCAL stack.
# The application itself never uses this key. Never set it in Vercel.
SUPABASE_SECRET_KEY=
