# Copy to .env.local and fill in. Never commit .env.local.
# Local values are printed by `npx supabase status`.

# Public: safe to expose to the browser. Data access is protected by Row Level Security.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Map tiles. Defaults to OpenStreetMap, which is fine for development but has a strict
# usage policy; use a licensed provider (ideally satellite imagery) in production.
NEXT_PUBLIC_MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
NEXT_PUBLIC_MAP_TILE_ATTRIBUTION=&copy; OpenStreetMap contributors

# Server only (never NEXT_PUBLIC_): enables AI crop-health help on crop photos and the farm
# assistant. Leave empty to switch both off. Data is sent to Anthropic only when a farmer asks.
ANTHROPIC_API_KEY=

# Weather forecasts (Open-Meteo). Works without a key for development and non-commercial use;
# a commercial deployment needs an Open-Meteo plan: set its key here (server only).
OPEN_METEO_API_KEY=

# TESTS ONLY: used by integration/e2e tests to clean up test users on the LOCAL stack.
# The application itself never uses this key. Never set it in Vercel.
SUPABASE_SECRET_KEY=

# Shown on the data-use notice (/privacy) as who to contact with questions or complaints about
# personal data (DPDP Act 2023): the organisation running Kisan 360 and its grievance contact,
# e.g. "Example Agri Pvt Ltd — Grievance Officer: Name, +91 90000 00000, privacy@example.org".
PRIVACY_CONTACT=
